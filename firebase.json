{
  "hosting": {
    "target": "app",
    "public": "web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "assets/ort-wasm-*.wasm"
    ],
    "rewrites": [
      {
        "source": "/mcp",
        "function": {
          "functionId": "mcp",
          "region": "europe-north1"
        }
      },
      {
        "source": "/glossary",
        "destination": "/glossary.html"
      },
      {
        "source": "/model",
        "destination": "/model.html"
      },
      {
        "source": "/data",
        "destination": "/data.html"
      },
      {
        "source": "/evals",
        "destination": "/evals.html"
      },
      {
        "source": "/dashboard",
        "destination": "/pages/dashboard.html"
      },
      {
        "source": "/materials",
        "destination": "/pages/materials.html"
      },
      {
        "source": "/category/jackets-and-hoodies",
        "destination": "/pages/category/jackets-and-hoodies.html"
      },
      {
        "source": "/category/blazers-and-vests",
        "destination": "/pages/category/blazers-and-vests.html"
      },
      {
        "source": "/category/knits",
        "destination": "/pages/category/knits.html"
      },
      {
        "source": "/category/shirts",
        "destination": "/pages/category/shirts.html"
      },
      {
        "source": "/category/t-shirts-and-tanks",
        "destination": "/pages/category/t-shirts-and-tanks.html"
      },
      {
        "source": "/category/pants",
        "destination": "/pages/category/pants.html"
      },
      {
        "source": "/category/shorts",
        "destination": "/pages/category/shorts.html"
      },
      {
        "source": "/category/belts",
        "destination": "/pages/category/belts.html"
      },
      {
        "source": "/category/socks",
        "destination": "/pages/category/socks.html"
      },
      {
        "source": "/category/shoes",
        "destination": "/pages/category/shoes.html"
      },
      {
        "source": "/category/underwear-shirts",
        "destination": "/pages/category/underwear-shirts.html"
      },
      {
        "source": "/category/underwear-boxers",
        "destination": "/pages/category/underwear-boxers.html"
      },
      {
        "source": "/category/sportswear",
        "destination": "/pages/category/sportswear.html"
      },
      {
        "source": "**",
        "destination": "/app.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/!(*.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/app.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/def/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/portfolio.html",
        "destination": "/dashboard",
        "type": 301
      },
      {
        "source": "/jackets.html",
        "destination": "/category/jackets-and-hoodies",
        "type": 301
      },
      {
        "source": "/blazers.html",
        "destination": "/category/blazers-and-vests",
        "type": 301
      },
      {
        "source": "/knits.html",
        "destination": "/category/knits",
        "type": 301
      },
      {
        "source": "/shirts.html",
        "destination": "/category/shirts",
        "type": 301
      },
      {
        "source": "/t-shirts.html",
        "destination": "/category/t-shirts-and-tanks",
        "type": 301
      },
      {
        "source": "/pants.html",
        "destination": "/category/pants",
        "type": 301
      },
      {
        "source": "/shorts.html",
        "destination": "/category/shorts",
        "type": 301
      },
      {
        "source": "/belts.html",
        "destination": "/category/belts",
        "type": 301
      },
      {
        "source": "/socks.html",
        "destination": "/category/socks",
        "type": 301
      },
      {
        "source": "/shoes.html",
        "destination": "/category/shoes",
        "type": 301
      },
      {
        "source": "/uw_shirts.html",
        "destination": "/category/underwear-shirts",
        "type": 301
      },
      {
        "source": "/uw_boxers.html",
        "destination": "/category/underwear-boxers",
        "type": 301
      },
      {
        "source": "/sportswear.html",
        "destination": "/category/sportswear",
        "type": 301
      },
      {
        "source": "/track_your_wardrobe.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/data.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/development.html",
        "destination": "/category/shoes",
        "type": 301
      },
      {
        "source": "/GA_script.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/REMOVED_navbar.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/footer.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/header_meta_tags.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/hero-image.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/bit.ly/:code",
        "destination": "https://bit.ly/:code",
        "type": 301
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": [
    {
      "target": "photos",
      "rules": "storage.rules"
    },
    {
      "target": "plots",
      "rules": "storage-plots.rules"
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "mcp",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".gitignore",
        "README.md"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR/../mcp\" run build:function"
      ]
    }
  ],
  "extensions": {}
}
