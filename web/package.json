{
  "name": "wardrobe-diary-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:emulator": "vite --mode emulator --port 5174 --strictPort",
    "ui-check": "node e2e/ui-check.mjs",
    "build": "node scripts/semantics.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "deploy": "npm run build && firebase deploy --only hosting:app,firestore",
    "semantics": "node scripts/semantics.mjs"
  },
  "dependencies": {
    "@observablehq/plot": "^0.6.17",
    "firebase": "^12.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "^15.34.0",
    "puppeteer-core": "^25.14.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "uuid": "^11.1.1",
    "@opentelemetry/core": "^2.8.0"
  }
}
