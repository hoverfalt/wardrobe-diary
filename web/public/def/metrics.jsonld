{
 "@context": {
  "@vocab": "https://wardrobediary.io/def/vocab#",
  "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
  "owl": "http://www.w3.org/2002/07/owl#",
  "skos": "http://www.w3.org/2004/02/skos/core#",
  "dcat": "http://www.w3.org/ns/dcat#",
  "dct": "http://purl.org/dc/terms/",
  "prov": "http://www.w3.org/ns/prov#",
  "schema": "https://schema.org/",
  "xsd": "http://www.w3.org/2001/XMLSchema#",
  "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
  "foaf": "http://xmlns.com/foaf/0.1/",
  "adms": "http://www.w3.org/ns/adms#"
 },
 "@graph": [
  {
   "@id": "https://wardrobediary.io/def/metrics",
   "rdfs:label": "Wardrobe Diary semantic model (metrics)",
   "owl:versionInfo": "0.2.1",
   "dct:license": {
    "@id": "https://creativecommons.org/licenses/by/4.0/"
   }
  },
  {
   "@id": "https://wardrobediary.io/model#metric-times-worn",
   "@type": "Metric",
   "rdfs:label": "Times worn",
   "skos:definition": "Wears of the garment within the range (and within its ownership period), plus pre-tracking wears when the range starts on the start of tracking.",
   "formula": "|{wear days d : range.from ≤ d ≤ range.to, d in ownership}| + (range.from ≤ 2018-01-01 ? timesUsedInit : 0)",
   "grain": "garment",
   "unit": "count",
   "rangeRule": "range",
   "dct:subject": {
    "@id": "https://wardrobediary.io/glossary#times-worn"
   },
   "prov:used": [
    {
     "@id": "https://wardrobediary.io/data#days.worn"
    },
    {
     "@id": "https://wardrobediary.io/data#days.date"
    },
    {
     "@id": "https://wardrobediary.io/data#garments.timesUsedInit"
    },
    {
     "@id": "https://wardrobediary.io/data#garments.purchased"
    },
    {
     "@id": "https://wardrobediary.io/data#garments.divested"
    }
   ],
   "implementation": {
    "@id": "https://github.com/hoverfalt/wardrobe-diary/blob/main/web/src/lib/metrics.ts"
   },
   "test": [
    "web/src/lib/metrics.test.ts › counts times worn including pre-tracking wears, ignoring wears outside ownership",
    "web/src/lib/metrics.test.ts › counts pre-tracking wears only when the range starts at the start of tracking"
   ]
  },
  {
   "@id": "https://wardrobediary.io/model#metric-lifetime-wears",
   "@type": "Metric",
   "rdfs:label": "Lifetime wears",
   "skos:definition": "All wears over the garment's whole ownership period, including pre-tracking wears.",
   "formula": "times-worn over {from: 2018-01-01, to: open}",
   "grain": "garment",
   "unit": "count",
   "rangeRule": "lifetime",
   "dct:subject": {
    "@id": "https://wardrobediary.io/glossary#lifetime-wears"
   },
   "dependsOn": [
    {
     "@id": "https://wardrobediary.io/model#metric-times-worn"
    }
   ],
   "implementation": {
    "@id": "https://github.com/hoverfalt/wardrobe-diary/blob/main/web/src/lib/metrics.ts"
   }
  },
  {
   "@id": "https://wardrobediary.io/model#metric-garment-cost-per-wear",
   "@type": "Metric",
   "rdfs:label": "Cost per wear (garment)",
   "skos:definition": "Price divided by lifetime wears, independent of any chosen range; a garment never worn costs its full price.",
   "formula": "lifetime-wears = 0 ? price : price / lifetime-wears",
   "grain": "garment",
   "unit": "EUR per wear",
   "rangeRule": "lifetime",
   "nullWhen": "the price is unknown",
   "dct:subject": {
    "@id": "https://wardrobediary.io/glossary#cost-per-wear"
   },
   "prov:used": [
    {
     "@id": "https://wardrobediary.io/data#garments.price"
    }
   ],
   "dependsOn": [
    {
     "@id": "https://wardrobediary.io/model#metric-lifetime-wears"
    }
   ],
   "dct:references": [
    {
     "@id": "https://wardrobediary.io/model#decision-D-2"
    }
   ],
   "implementation": {
    "@id": "https://github.com/hoverfalt/wardrobe-diary/blob/main/web/src/lib/metrics.ts"
   },
   "test": [
    "web/src/lib/metrics.test.ts › computes cost per wear over the whole ownership; unworn garments cost their full price",
    "web/src/lib/metrics.test.ts › computes cost per wear independently of any range, including wears after it (D-2)"
   ]
  },
  {
   "@id": "https://wardrobediary.io/model#metric-days-owned",
   "@type": "Metric",
   "rdfs:label": "Days owned",
   "skos:definition": "Days owned within the range up to its end, frozen at the divest date. When the range starts on the start of tracking, counted from the purchase date even before tracking (since pre-tracking wears are included too).",
   "formula": "max(0, days(start .. min(range.to, divested))) with start = range.from ≤ 2018-01-01 ? purchased : max(range.from, ownedFrom)",
   "grain": "garment",
   "unit": "days",
   "rangeRule": "range",
   "prov:used": [
    {
     "@id": "https://wardrobediary.io/data#garments.purchased"
    },
    {
     "@id": "https://wardrobediary.io/data#garments.divested"
    }
   ],
   "implementation": {
    "@id": "https://github.com/hoverfalt/wardrobe-diary/blob/main/web/src/lib/metrics.ts"
   },
   "test": [
    "web/src/lib/metrics.test.ts › counts days owned from purchase, frozen at the divest date"
   ]
  },
  {
   "@id": "https://wardrobediary.io/model#metric-wears-per-month",
   "@type": "Metric",
   "rdfs:label": "Wears per month",
   "skos:definition": "Times worn divided by months owned in the range (30.5 days per month); 0 if not owned in the range.",
   "formula": "days-owned > 0 ? times-worn / (days-owned / 30.5) : 0",
   "grain": "garment",
   "unit": "wears per month",
   "rangeRule": "range",
   "dct:subject": {
    "@id": "https://wardrobediary.io/glossary#wears-per-month"
   },
   "dependsOn": [
    {
     "@id": "https://wardrobediary.io/model#metric-times-worn"
    },
    {
     "@id": "https://wardrobediary.io/model#metric-days-owned"
    }
   ],
   "implementation": {
    "@id": "https://github.com/hoverfalt/wardrobe-diary/blob/main/web/src/lib/metrics.ts"
   },
   "test": [
    "web/src/lib/metrics.test.ts › lists items with wears per month"
   ]
  },
  {
   "@id": "https://wardrobediary.io/model#metric-active-items",
   "@type": "Metric",
   "rdfs:label": "Active items",
   "skos:definition": "Number of the category's garments active on the range's end date. Total row - the sum over categories.",
   "formula": "|{garments g in category : active(g, range.to)}|",
   "grain": "category",
   "unit": "count",
   "rangeRule": "end-date",
   "dct:subject": {
    "@id": "https://wardrobediary.io/glossary#active-items"
   },
   "prov:used": [
    {
     "@id": "https://wardrobediary.io/data#garments.category"
    },
    {
     "@id": "https://wardrobediary.io/data#garments.purchased"
    },
    {
     "@id": "https://wardrobediary.io/data#garments.divested"
    }
   ],
   "implementation": {
    "@id": "https://github.com/hoverfalt/wardrobe-diary/blob/main/web/src/lib/metrics.ts"
   },
   "test": [
    "web/src/lib/metrics.test.ts › summarises a category"
   ]
  },
  {
   "@id": "https://wardrobediary.io/model#metric-inventory-value",
   "@type": "Metric",
   "rdfs:label": "Inventory value",
   "skos:definition": "Sum of the prices of the category's garments active on the range's end date (unknown prices count as 0). Total row - the sum.",
   "formula": "Σ price over active garments on range.to",
   "grain": "category",
   "unit": "EUR",
   "rangeRule": "end-date",
   "dct:subject": {
    "@id": "https://wardrobediary.io/glossary#inventory-value"
   },
   "prov:used": [
    {
     "@id": "https://wardrobediary.io/data#garments.price"
    }
   ],
   "dependsOn": [
    {
     "@id": "https://wardrobediary.io/model#metric-active-items"
    }
   ],
   "implementation": {
    "@id": "https://github.com/hoverfalt/wardrobe-diary/blob/main/web/src/lib/metrics.ts"
   },
   "test": [
    "web/src/lib/metrics.test.ts › summarises a category"
   ]
  },
  {
   "@id": "https://wardrobediary.io/model#metric-category-cost-per-wear",
   "@type": "Metric",
   "rdfs:label": "Cost per wear (category)",
   "skos:definition": "The sum of the prices of the category's garments owned at any point in the range, divided by the sum of their lifetime wears. Unworn garments count with their full price and no wears; if none of them has ever been worn, the sum of prices is divided by 1 (as an unworn garment costs its full price). Garments without a price are left out. No Total row value.",
   "formula": "Σ price / max(1, Σ lifetime-wears), over the category's garments owned during the range with a price",
   "grain": "category",
   "unit": "EUR per wear",
   "rangeRule": "range (which garments) + lifetime (their wears)",
   "nullWhen": "no garment of the category with a price was owned in the range",
   "dct:subject": {
    "@id": "https://wardrobediary.io/glossary#cost-per-wear"
   },
   "prov:used": [
    {
     "@id": "https://wardrobediary.io/data#garments.price"
    }
   ],
   "dependsOn": [
    {
     "@id": "https://wardrobediary.io/model#metric-lifetime-wears"
    }
   ],
   "dct:references": [
    {
     "@id": "https://wardrobediary.io/model#decision-D-2"
    }
   ],
   "implementation": {
    "@id": "https://github.com/hoverfalt/wardrobe-diary/blob/main/web/src/lib/metrics.ts"
   },
   "test": [
    "web/src/lib/metrics.test.ts › pools prices over lifetime wears of all garments owned in the range, unworn ones included (D-2)",
    "web/src/lib/metrics.test.ts › weights garments by lifetime wears, not by wears in the range (D-2)",
    "web/src/lib/metrics.test.ts › divides by 1 when no garment of the category has ever been worn, and skips unknown prices"
   ]
  },
  {
   "@id": "https://wardrobediary.io/model#metric-days-used",
   "@type": "Metric",
   "rdfs:label": "Days used",
   "skos:definition": "Share of days with at least one wear of a category garment, from the later of the range start and the day the category's first garment was owned, to the range end. No Total row value.",
   "formula": "|{days d in span : some category garment worn on d}| / |span|, span = max(range.from, min ownedFrom) .. range.to",
   "grain": "category",
   "unit": "share",
   "rangeRule": "range",
   "dct:subject": {
    "@id": "https://wardrobediary.io/glossary#days-used"
   },
   "dependsOn": [
    {
     "@id": "https://wardrobediary.io/model#metric-times-worn"
    }
   ],
   "implementation": {
    "@id": "https://github.com/hoverfalt/wardrobe-diary/blob/main/web/src/lib/metrics.ts"
   },
   "test": [
    "web/src/lib/metrics.test.ts › summarises a category"
   ]
  },
  {
   "@id": "https://wardrobediary.io/model#metric-yearly-cost",
   "@type": "Metric",
   "rdfs:label": "Yearly cost",
   "skos:definition": "Category cost per wear × 365 × days used. Total row - the sum over categories.",
   "formula": "category-cost-per-wear × 365 × days-used",
   "grain": "category",
   "unit": "EUR per year",
   "rangeRule": "range",
   "nullWhen": "cost per wear or days used is missing",
   "dct:subject": {
    "@id": "https://wardrobediary.io/glossary#yearly-cost"
   },
   "dependsOn": [
    {
     "@id": "https://wardrobediary.io/model#metric-category-cost-per-wear"
    },
    {
     "@id": "https://wardrobediary.io/model#metric-days-used"
    }
   ],
   "implementation": {
    "@id": "https://github.com/hoverfalt/wardrobe-diary/blob/main/web/src/lib/metrics.ts"
   },
   "test": [
    "web/src/lib/metrics.test.ts › adds a total row"
   ]
  },
  {
   "@id": "https://wardrobediary.io/model#metric-monthly-cost",
   "@type": "Metric",
   "rdfs:label": "Monthly cost",
   "skos:definition": "Yearly cost divided by 12, as in the original R comparison chart.",
   "formula": "yearly-cost / 12",
   "grain": "category",
   "unit": "EUR per month",
   "rangeRule": "range",
   "dct:subject": {
    "@id": "https://wardrobediary.io/glossary#monthly-cost"
   },
   "dependsOn": [
    {
     "@id": "https://wardrobediary.io/model#metric-yearly-cost"
    }
   ],
   "implementation": {
    "@id": "https://github.com/hoverfalt/wardrobe-diary/blob/main/web/src/pages/Dashboard.tsx"
   }
  },
  {
   "@id": "https://wardrobediary.io/model#metric-turnover",
   "@type": "Metric",
   "rdfs:label": "Inventory turnover",
   "skos:definition": "Yearly cost divided by inventory value. Total row - Σ yearly cost / Σ inventory value.",
   "formula": "yearly-cost / inventory-value",
   "grain": "category",
   "unit": "share per year",
   "rangeRule": "range",
   "nullWhen": "yearly cost is missing or inventory value is 0",
   "dct:subject": {
    "@id": "https://wardrobediary.io/glossary#turnover"
   },
   "dependsOn": [
    {
     "@id": "https://wardrobediary.io/model#metric-yearly-cost"
    },
    {
     "@id": "https://wardrobediary.io/model#metric-inventory-value"
    }
   ],
   "implementation": {
    "@id": "https://github.com/hoverfalt/wardrobe-diary/blob/main/web/src/lib/metrics.ts"
   },
   "test": [
    "web/src/lib/metrics.test.ts › adds a total row"
   ]
  },
  {
   "@id": "https://wardrobediary.io/model#metric-second-hand-share",
   "@type": "Metric",
   "rdfs:label": "Second hand share",
   "skos:definition": "Share of the category's garments active on the range's end date that carry the second-hand tag (by count). Total row - over all active garments.",
   "formula": "|{active garments tagged second-hand}| / |{active garments}|",
   "grain": "category",
   "unit": "share",
   "rangeRule": "end-date",
   "nullWhen": "no garment is active",
   "dct:subject": {
    "@id": "https://wardrobediary.io/glossary#second-hand-share"
   },
   "prov:used": [
    {
     "@id": "https://wardrobediary.io/data#garments.tags"
    }
   ],
   "implementation": {
    "@id": "https://github.com/hoverfalt/wardrobe-diary/blob/main/web/src/lib/metrics.ts"
   },
   "test": [
    "web/src/lib/metrics.test.ts › gives the second-hand share of active garments, per category and in total"
   ]
  },
  {
   "@id": "https://wardrobediary.io/model#metric-divested-averages",
   "@type": "Metric",
   "rdfs:label": "Divested items' averages",
   "skos:definition": "Over divested garments owned at least 30 days: wears per month (Σ times worn / Σ days owned × 30.5) and the use-weighted cost per wear. Reference lines on category pages.",
   "formula": "(Σ times-worn / Σ days-owned) × 30.5; Σ (cost per wear × times-worn) / Σ times-worn",
   "grain": "category",
   "unit": "wears per month; EUR per wear",
   "rangeRule": "range",
   "dependsOn": [
    {
     "@id": "https://wardrobediary.io/model#metric-times-worn"
    },
    {
     "@id": "https://wardrobediary.io/model#metric-days-owned"
    },
    {
     "@id": "https://wardrobediary.io/model#metric-garment-cost-per-wear"
    }
   ],
   "implementation": {
    "@id": "https://github.com/hoverfalt/wardrobe-diary/blob/main/web/src/lib/metrics.ts"
   },
   "test": [
    "web/src/lib/metrics.test.ts › averages divested items owned at least 30 days"
   ]
  },
  {
   "@id": "https://wardrobediary.io/model#metric-active-items-over-time",
   "@type": "Metric",
   "rdfs:label": "Active items over time",
   "skos:definition": "Active items per category on every day of the range, as step series (Sportswear left out on the Dashboard).",
   "formula": "active-items(category, d) for each day d in range",
   "grain": "category × day",
   "unit": "count",
   "rangeRule": "each day",
   "dependsOn": [
    {
     "@id": "https://wardrobediary.io/model#metric-active-items"
    }
   ],
   "implementation": {
    "@id": "https://github.com/hoverfalt/wardrobe-diary/blob/main/web/src/lib/metrics.ts"
   },
   "test": [
    "web/src/lib/metrics.test.ts › steps up on purchase and down the day after divesting",
    "web/src/lib/metrics.test.ts › agrees with isActive on every day"
   ]
  },
  {
   "@id": "https://wardrobediary.io/model#metric-inventory-value-over-time",
   "@type": "Metric",
   "rdfs:label": "Inventory value over time",
   "skos:definition": "Inventory value per category (and in total) on every day of the range, as step series.",
   "formula": "inventory-value(category, d) for each day d in range",
   "grain": "category × day",
   "unit": "EUR",
   "rangeRule": "each day",
   "dependsOn": [
    {
     "@id": "https://wardrobediary.io/model#metric-inventory-value"
    }
   ],
   "implementation": {
    "@id": "https://github.com/hoverfalt/wardrobe-diary/blob/main/web/src/lib/metrics.ts"
   },
   "test": [
    "web/src/lib/metrics.test.ts › sums prices of active garments per category, in whole cents",
    "web/src/lib/metrics.test.ts › sums all categories for the total"
   ]
  },
  {
   "@id": "https://wardrobediary.io/model#metric-daily-cost",
   "@type": "Metric",
   "rdfs:label": "Daily cost",
   "skos:definition": "For each logged day in the range with wears: the sum of the lifetime cost per wear of the garments worn and owned that day (unknown prices count 0); \"final\" when all of them are divested. Average - the mean of 30 consecutive logged days centred on the day (days i−14 … i+15), so days without wears are skipped.",
   "formula": "Σ garment-cost-per-wear over garments worn on d; average(i) = mean(cost[i−14 .. i+15])",
   "grain": "day",
   "unit": "EUR per day",
   "rangeRule": "each day + lifetime (cost per wear)",
   "dct:subject": {
    "@id": "https://wardrobediary.io/glossary#daily-cost"
   },
   "dependsOn": [
    {
     "@id": "https://wardrobediary.io/model#metric-garment-cost-per-wear"
    }
   ],
   "dct:references": [
    {
     "@id": "https://wardrobediary.io/model#decision-D-2"
    },
    {
     "@id": "https://wardrobediary.io/model#decision-Q-1"
    }
   ],
   "implementation": {
    "@id": "https://github.com/hoverfalt/wardrobe-diary/blob/main/web/src/lib/metrics.ts"
   },
   "test": [
    "web/src/lib/metrics.test.ts › sums lifetime cost per wear of the garments worn each day (D-2)",
    "web/src/lib/metrics.test.ts › centres a 30-value window on values i-14 … i+15"
   ]
  },
  {
   "@id": "https://wardrobediary.io/model#metric-fibre-mass",
   "@type": "Metric",
   "rdfs:label": "Fibre mass",
   "skos:definition": "Weight × main-part composition, summed per fibre, with recycled and organic kg. Owned basis - garments active on the range's end date. Worn basis - each wear in the range counts the garment's full weight. Only garments with a weight and readable materials are included; coverage says how many.",
   "formula": "Σ weightG / 1000 × fibreShare",
   "grain": "fibre",
   "unit": "kg",
   "rangeRule": "end-date (owned) or range (worn)",
   "dct:subject": {
    "@id": "https://wardrobediary.io/glossary#fibre-mass"
   },
   "prov:used": [
    {
     "@id": "https://wardrobediary.io/data#garments.weightG"
    },
    {
     "@id": "https://wardrobediary.io/data#garments.materials"
    }
   ],
   "implementation": {
    "@id": "https://github.com/hoverfalt/wardrobe-diary/blob/main/web/src/lib/materials.ts"
   },
   "test": [
    "web/src/lib/materials.test.ts › adds up owned fibre mass from weight × composition",
    "web/src/lib/materials.test.ts › counts each wear for the worn basis, with the average outfit weight"
   ]
  },
  {
   "@id": "https://wardrobediary.io/model#metric-average-outfit-weight",
   "@type": "Metric",
   "rdfs:label": "Average outfit weight",
   "skos:definition": "Mean total weight of the garments worn per logged day (garments with a known weight).",
   "formula": "Σ weight of garments worn / number of logged days",
   "grain": "range or month",
   "unit": "kg per day",
   "rangeRule": "range",
   "dct:subject": {
    "@id": "https://wardrobediary.io/glossary#outfit-weight"
   },
   "prov:used": [
    {
     "@id": "https://wardrobediary.io/data#garments.weightG"
    },
    {
     "@id": "https://wardrobediary.io/data#days.worn"
    }
   ],
   "implementation": {
    "@id": "https://github.com/hoverfalt/wardrobe-diary/blob/main/web/src/lib/materials.ts"
   },
   "test": [
    "web/src/lib/materials.test.ts › computes outfit weight and synthetic share per month"
   ]
  },
  {
   "@id": "https://wardrobediary.io/model#metric-synthetic-share",
   "@type": "Metric",
   "rdfs:label": "Synthetic share (worn)",
   "skos:definition": "Share of the worn fibre mass in a month that is synthetic.",
   "formula": "synthetic kg / total kg (worn basis)",
   "grain": "month",
   "unit": "share",
   "rangeRule": "range (by month)",
   "dependsOn": [
    {
     "@id": "https://wardrobediary.io/model#metric-fibre-mass"
    }
   ],
   "implementation": {
    "@id": "https://github.com/hoverfalt/wardrobe-diary/blob/main/web/src/lib/materials.ts"
   },
   "test": [
    "web/src/lib/materials.test.ts › computes outfit weight and synthetic share per month"
   ]
  },
  {
   "@id": "https://wardrobediary.io/model#metric-comparison-yearly-cost",
   "@type": "Metric",
   "rdfs:label": "Yearly cost (comparison item)",
   "skos:definition": "Monthly cost × 12.",
   "formula": "monthlyCost × 12",
   "grain": "comparison item",
   "unit": "EUR per year",
   "rangeRule": "none (fixed figures)",
   "prov:used": [
    {
     "@id": "https://wardrobediary.io/data#comparison.monthlyCost"
    }
   ],
   "implementation": {
