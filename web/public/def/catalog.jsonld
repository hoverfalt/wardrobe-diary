{
 "@context": {
  "@vocab": "https://wardrobediary.io/def/vocab#",
  "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
  "owl": "http://www.w3.org/2002/07/owl#",
  "skos": "http://www.w3.org/2004/02/skos/core#",
  "dcat": "http://www.w3.org/ns/dcat#",
  "dct": "http://purl.org/dc/terms/",
  "prov": "http://www.w3.org/ns/prov#",
  "schema": "https://schema.org/",
  "xsd": "http://www.w3.org/2001/XMLSchema#",
  "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
  "foaf": "http://xmlns.com/foaf/0.1/",
  "adms": "http://www.w3.org/ns/adms#"
 },
 "@id": "https://wardrobediary.io/data",
 "@type": "dcat:Catalog",
 "dct:title": "Wardrobe Diary data catalog",
 "dct:license": {
  "@id": "https://creativecommons.org/licenses/by/4.0/"
 },
 "dct:publisher": {
  "@type": "schema:Person",
  "schema:name": "Olof Hoverfält",
  "schema:url": "https://www.linkedin.com/in/hoverfalt/"
 },
 "foaf:homepage": {
  "@id": "https://wardrobediary.io/"
 },
 "dct:temporal": {
  "@type": "dct:PeriodOfTime",
  "dcat:startDate": "2018-01-01"
 },
 "owl:versionInfo": "0.4.0",
 "dcat:dataset": [
  {
   "@id": "https://wardrobediary.io/data#garments",
   "@type": "dcat:Dataset",
   "dct:title": "Garments",
   "dct:description": "Every garment owned at some point since tracking began, with its details. The source of truth for garment details (decision D-4).",
   "dct:accessRights": {
    "@id": "http://publications.europa.eu/resource/authority/access-right/RESTRICTED"
   },
   "classification": "owner-only",
   "location": "Firestore users/{uid}/garments/{garmentId}",
   "dct:subject": {
    "@id": "https://wardrobediary.io/model#class-Garment"
   },
   "prov:wasDerivedFrom": [
    {
     "@id": "https://wardrobediary.io/data#legacy-sheet"
    }
   ],
   "prov:qualifiedDerivation": [
    {
     "@type": "prov:Derivation",
     "prov:entity": [
      {
       "@id": "https://wardrobediary.io/data#legacy-sheet"
      }
     ],
     "prov:hadActivity": "Sheet → Firestore migration and sync",
     "until": "2026-10-09",
     "dct:references": {
      "@id": "https://wardrobediary.io/model#decision-D-4"
     }
    },
    {
     "@type": "prov:Derivation",
     "prov:entity": [
      "owner"
     ],
     "prov:hadActivity": "edited in the app (/manage)",
     "since": "2026-10-09"
    }
   ],
   "schema:variableMeasured": [
    {
     "@id": "https://wardrobediary.io/data#garments.id",
     "@type": "schema:PropertyValue",
     "schema:name": "id",
     "schema:description": "Garment id, from the original Sheet's Photo id (e.g. Jackets_and_hoodies-006); also the photo file name.",
     "schema:valueReference": "text",
     "required": true,
     "constraints": "pattern <Category_words>-NNN; unique"
    },
    {
     "@id": "https://wardrobediary.io/data#garments.category",
     "@type": "schema:PropertyValue",
     "schema:name": "category",
     "schema:description": "The garment's category.",
     "schema:valueReference": "text",
     "required": true,
     "constraints": "one of the 13 standard categories",
     "dct:subject": {
      "@id": "https://wardrobediary.io/glossary#category"
     }
    },
    {
     "@id": "https://wardrobediary.io/data#garments.item",
     "@type": "schema:PropertyValue",
     "schema:name": "item",
     "schema:description": "Name (brand, model, colour; numbered when identical items exist).",
     "schema:valueReference": "text",
     "required": true
    },
    {
     "@id": "https://wardrobediary.io/data#garments.details",
     "@type": "schema:PropertyValue",
     "schema:name": "details",
     "schema:description": "Free-text details such as size or model code.",
     "schema:valueReference": "text",
     "required": false
    },
    {
     "@id": "https://wardrobediary.io/data#garments.photo",
     "@type": "schema:PropertyValue",
     "schema:name": "photo",
     "schema:description": "Photo file name without .png in public storage.",
     "schema:valueReference": "text",
     "required": true
    },
    {
     "@id": "https://wardrobediary.io/data#garments.photoVersion",
     "@type": "schema:PropertyValue",
     "schema:name": "photoVersion",
     "schema:description": "Set when the photo is replaced; part of the photo URL so caches show the new one.",
     "schema:valueReference": "text",
     "required": false
    },
    {
     "@id": "https://wardrobediary.io/data#garments.price",
     "@type": "schema:PropertyValue",
     "schema:name": "price",
     "schema:description": "What was paid, rounded to whole cents.",
     "schema:valueReference": "money-eur",
     "required": false,
     "constraints": "≥ 0",
     "dct:subject": {
      "@id": "https://wardrobediary.io/glossary#price"
     }
    },
    {
     "@id": "https://wardrobediary.io/data#garments.purchased",
     "@type": "schema:PropertyValue",
     "schema:name": "purchased",
     "schema:description": "Purchase date.",
     "schema:valueReference": "date",
     "required": false,
     "constraints": "≤ divested"
    },
    {
     "@id": "https://wardrobediary.io/data#garments.divested",
     "@type": "schema:PropertyValue",
     "schema:name": "divested",
     "schema:description": "Last day owned; empty while active.",
     "schema:valueReference": "date",
     "required": false,
     "dct:subject": {
      "@id": "https://wardrobediary.io/glossary#divested"
     }
    },
    {
     "@id": "https://wardrobediary.io/data#garments.timesUsedInit",
     "@type": "schema:PropertyValue",
     "schema:name": "timesUsedInit",
     "schema:description": "Wears before tracking began (estimate).",
     "schema:valueReference": "integer",
     "required": true,
     "constraints": "≥ 0",
     "dct:subject": {
      "@id": "https://wardrobediary.io/glossary#pre-tracking-wears"
     }
    },
    {
     "@id": "https://wardrobediary.io/data#garments.materials",
     "@type": "schema:PropertyValue",
     "schema:name": "materials",
     "schema:description": "The materials label as written.",
     "schema:valueReference": "text",
     "required": false,
     "dct:subject": {
      "@id": "https://wardrobediary.io/glossary#materials"
     }
    },
    {
     "@id": "https://wardrobediary.io/data#garments.weightG",
     "@type": "schema:PropertyValue",
     "schema:name": "weightG",
     "schema:description": "Weight in grams.",
     "schema:valueReference": "mass-g",
     "required": false,
     "constraints": "> 0"
    },
    {
     "@id": "https://wardrobediary.io/data#garments.tags",
     "@type": "schema:PropertyValue",
     "schema:name": "tags",
     "schema:description": "Descriptive tags.",
     "schema:valueReference": "list of text",
     "required": false,
     "constraints": "each one of: second-hand, hanko, bicycle, motorcycle, winter, summer",
     "dct:subject": {
      "@id": "https://wardrobediary.io/glossary#tag"
     }
    },
    {
     "@id": "https://wardrobediary.io/data#garments.detailsUnavailable",
     "@type": "schema:PropertyValue",
     "schema:name": "detailsUnavailable",
     "schema:description": "Divested only: missing materials or weight can no longer be filled in (left off the review list).",
     "schema:valueReference": "boolean",
     "required": false
    }
   ]
  },
  {
   "@id": "https://wardrobediary.io/data#garment-history",
   "@type": "dcat:Dataset",
   "dct:title": "Garment history",
   "dct:description": "Every saved version of every garment (an audit trail), including the version before each change.",
   "dct:accessRights": {
    "@id": "http://publications.europa.eu/resource/authority/access-right/RESTRICTED"
   },
   "classification": "owner-only",
   "location": "Firestore users/{uid}/garments/{garmentId}/history/{autoId}",
   "prov:wasDerivedFrom": [
    {
     "@id": "https://wardrobediary.io/data#garments"
    }
   ],
   "prov:qualifiedDerivation": [
    {
     "@type": "prov:Derivation",
     "prov:entity": [
      {
       "@id": "https://wardrobediary.io/data#garments"
      }
     ],
     "prov:hadActivity": "written in the same transaction as each garment save"
    }
   ],
   "schema:variableMeasured": [
    {
     "@id": "https://wardrobediary.io/data#garment-history.savedAt",
     "@type": "schema:PropertyValue",
     "schema:name": "savedAt",
     "schema:description": "When the version was saved.",
     "schema:valueReference": "timestamp",
     "required": true
    },
    {
     "@id": "https://wardrobediary.io/data#garment-history.before",
     "@type": "schema:PropertyValue",
     "schema:name": "before",
     "schema:description": "The previous version; empty when the garment was created in the app.",
     "schema:valueReference": "garment",
     "required": false
    },
    {
     "@id": "https://wardrobediary.io/data#garment-history.after",
     "@type": "schema:PropertyValue",
     "schema:name": "after",
     "schema:description": "The saved version.",
     "schema:valueReference": "garment",
     "required": true
    },
    {
     "@id": "https://wardrobediary.io/data#garment-history.note",
     "@type": "schema:PropertyValue",
     "schema:name": "note",
     "schema:description": "What happened, e.g. \"Photo replaced\".",
     "schema:valueReference": "text",
     "required": false
    }
   ]
  },
  {
   "@id": "https://wardrobediary.io/data#deleted-garments",
   "@type": "dcat:Dataset",
   "dct:title": "Deleted garments",
   "dct:description": "Garments deleted in the app (only never-worn ones can be), kept as a record.",
   "dct:accessRights": {
    "@id": "http://publications.europa.eu/resource/authority/access-right/RESTRICTED"
   },
   "classification": "owner-only",
   "location": "Firestore users/{uid}/deletedGarments/{garmentId}",
   "schema:variableMeasured": [
    {
     "@id": "https://wardrobediary.io/data#deleted-garments.deletedAt",
     "@type": "schema:PropertyValue",
     "schema:name": "deletedAt",
     "schema:description": "When it was deleted.",
     "schema:valueReference": "timestamp",
     "required": true
    },
    {
     "@id": "https://wardrobediary.io/data#deleted-garments.garment",
     "@type": "schema:PropertyValue",
     "schema:name": "garment",
     "schema:description": "The garment as it was.",
     "schema:valueReference": "garment",
     "required": true
    }
   ]
  },
  {
   "@id": "https://wardrobediary.io/data#days",
   "@type": "dcat:Dataset",
   "dct:title": "Wear log",
   "dct:description": "One record per day with wears - the garments worn that day. Days with nothing worn have no record.",
   "dct:accessRights": {
    "@id": "http://publications.europa.eu/resource/authority/access-right/RESTRICTED"
   },
   "classification": "owner-only",
   "location": "Firestore users/{uid}/days/{YYYY-MM-DD}",
   "dct:subject": {
    "@id": "https://wardrobediary.io/model#class-WearDay"
   },
   "prov:wasDerivedFrom": [
    {
     "@id": "https://wardrobediary.io/data#legacy-sheet"
    }
   ],
   "prov:qualifiedDerivation": [
    {
     "@type": "prov:Derivation",
     "prov:entity": [
      {
       "@id": "https://wardrobediary.io/data#legacy-sheet"
      }
     ],
     "prov:hadActivity": "daily checkbox columns, migrated",
     "until": "2026-10-09"
    },
    {
     "@type": "prov:Derivation",
     "prov:entity": [
      "owner"
     ],
     "prov:hadActivity": "logged in the app (/log)",
     "since": "2026-10-10",
     "dct:references": {
      "@id": "https://wardrobediary.io/model#decision-R-15"
     }
    }
   ],
   "schema:variableMeasured": [
    {
     "@id": "https://wardrobediary.io/data#days.date",
     "@type": "schema:PropertyValue",
     "schema:name": "date",
     "schema:description": "The day (document id).",
     "schema:valueReference": "date",
     "required": true,
     "constraints": "≥ 2018-01-01; not in the future"
    },
    {
     "@id": "https://wardrobediary.io/data#days.worn",
     "@type": "schema:PropertyValue",
     "schema:name": "worn",
     "schema:description": "The garments worn that day.",
     "schema:valueReference": "list of garment ids",
     "required": true,
     "constraints": "each an existing garment id; no duplicates"
    }
   ]
  },
  {
   "@id": "https://wardrobediary.io/data#settings",
   "@type": "dcat:Dataset",
   "dct:title": "Settings",
   "dct:description": "App settings, e.g. settings/app.sheetRetired, the cut-over date after which the retired Sheet may no longer be synced.",
   "dct:accessRights": {
    "@id": "http://publications.europa.eu/resource/authority/access-right/RESTRICTED"
   },
   "classification": "owner-only",
   "location": "Firestore users/{uid}/settings/app",
   "schema:variableMeasured": [
    {
     "@id": "https://wardrobediary.io/data#settings.sheetRetired",
     "@type": "schema:PropertyValue",
     "schema:name": "sheetRetired",
     "schema:description": "Cut-over date (2026-10-09).",
     "schema:valueReference": "date",
     "required": false
    }
   ]
  },
  {
   "@id": "https://wardrobediary.io/data#comparison",
   "@type": "dcat:Dataset",
   "dct:title": "Comparison items",
   "dct:description": "Other everyday spending shown next to the clothing categories in the monthly cost chart.",
   "dct:accessRights": {
    "@id": "http://publications.europa.eu/resource/authority/access-right/RESTRICTED"
   },
   "classification": "owner-only",
   "location": "Firestore users/{uid}/settings/comparison (items)",
   "dct:subject": {
    "@id": "https://wardrobediary.io/model#class-ComparisonItem"
   },
   "prov:wasDerivedFrom": [
    {
     "@id": "https://wardrobediary.io/data#legacy-sheet"
    }
   ],
   "prov:qualifiedDerivation": [
    {
     "@type": "prov:Derivation",
     "prov:entity": [
      {
       "@id": "https://wardrobediary.io/data#legacy-sheet"
      }
     ],
     "prov:hadActivity": "one-off import of the Comparison tab (values only)",
     "until": "2026-10-12"
    },
    {
     "@type": "prov:Derivation",
     "prov:entity": [
      "owner"
     ],
     "prov:hadActivity": "edited in the app (/manage/comparison)",
     "since": "2026-10-12"
    }
   ],
   "schema:variableMeasured": [
    {
     "@id": "https://wardrobediary.io/data#comparison.id",
     "@type": "schema:PropertyValue",
     "schema:name": "id",
     "schema:description": "Item id (from its name).",
     "schema:valueReference": "text",
     "required": true
    },
    {
     "@id": "https://wardrobediary.io/data#comparison.type",
     "@type": "schema:PropertyValue",
     "schema:name": "type",
     "schema:description": "Kind of spending, e.g. Content, Physical service.",
     "schema:valueReference": "text",
     "required": false
    },
    {
     "@id": "https://wardrobediary.io/data#comparison.item",
     "@type": "schema:PropertyValue",
     "schema:name": "item",
     "schema:description": "Name.",
     "schema:valueReference": "text",
     "required": true
    },
    {
     "@id": "https://wardrobediary.io/data#comparison.details",
     "@type": "schema:PropertyValue",
     "schema:name": "details",
     "schema:description": "Free-text details.",
     "schema:valueReference": "text",
     "required": false
    },
    {
     "@id": "https://wardrobediary.io/data#comparison.photo",
     "@type": "schema:PropertyValue",
     "schema:name": "photo",
     "schema:description": "Photo file name (Comparison-<Name>) without .png; empty when none.",
     "schema:valueReference": "text",
     "required": false
    },
    {
     "@id": "https://wardrobediary.io/data#comparison.photoVersion",
     "@type": "schema:PropertyValue",
     "schema:name": "photoVersion",
     "schema:description": "Set when a photo is uploaded.",
     "schema:valueReference": "text",
     "required": false
    },
    {
     "@id": "https://wardrobediary.io/data#comparison.monthlyCost",
     "@type": "schema:PropertyValue",
     "schema:name": "monthlyCost",
     "schema:description": "Monthly cost (entered).",
     "schema:valueReference": "money-eur",
     "required": true,
     "constraints": "≥ 0"
    },
    {
     "@id": "https://wardrobediary.io/data#comparison.useFrequency",
     "@type": "schema:PropertyValue",
     "schema:name": "useFrequency",
     "schema:description": "Share of days used (entered).",
     "schema:valueReference": "share",
     "required": true,
     "constraints": "0–1",
     "dct:subject": {
      "@id": "https://wardrobediary.io/glossary#use-frequency"
     }
    }
   ]
  },
  {
   "@id": "https://wardrobediary.io/data#voice-log",
   "@type": "dcat:Dataset",
   "dct:title": "Dictation log",
   "dct:description": "Every item description dictated or typed on the Log page (\"Describe an item\"), the garments the matcher proposed and the one the owner added (if any), to measure how well matching works and compare matchers.",
   "dct:accessRights": {
    "@id": "http://publications.europa.eu/resource/authority/access-right/RESTRICTED"
   },
   "classification": "owner-only",
   "location": "Firestore users/{uid}/voiceLog/{autoId}",
   "prov:wasDerivedFrom": [],
   "prov:qualifiedDerivation": [
    {
     "@type": "prov:Derivation",
     "prov:entity": [
      "owner"
     ],
     "prov:hadActivity": "dictated on the Log page; proposals by web/src/lib/voiceMatch.ts",
     "since": "2026-10-18"
    }
   ],
   "schema:variableMeasured": [
    {
     "@id": "https://wardrobediary.io/data#voice-log.at",
     "@type": "schema:PropertyValue",
     "schema:name": "at",
     "schema:description": "When it was entered (ISO time).",
     "schema:valueReference": "text",
     "required": true
    },
    {
     "@id": "https://wardrobediary.io/data#voice-log.date",
     "@type": "schema:PropertyValue",
     "schema:name": "date",
     "schema:description": "The day being logged.",
     "schema:valueReference": "date",
     "required": true
    },
    {
     "@id": "https://wardrobediary.io/data#voice-log.text",
     "@type": "schema:PropertyValue",
     "schema:name": "text",
     "schema:description": "The description as dictated or typed.",
     "schema:valueReference": "text",
     "required": true
    },
    {
     "@id": "https://wardrobediary.io/data#voice-log.proposals",
     "@type": "schema:PropertyValue",
     "schema:name": "proposals",
     "schema:description": "The proposed garments, best first.",
     "schema:valueReference": "list of garment ids",
     "required": true
    },
    {
     "@id": "https://wardrobediary.io/data#voice-log.chosen",
     "@type": "schema:PropertyValue",
     "schema:name": "chosen",
     "schema:description": "The garment added from the proposals, or empty if none was.",
     "schema:valueReference": "text",
     "required": false
    },
    {
     "@id": "https://wardrobediary.io/data#voice-log.rank",
     "@type": "schema:PropertyValue",
     "schema:name": "rank",
     "schema:description": "The chosen garment's position in the proposals (0 = best).",
     "schema:valueReference": "integer",
     "required": false
    },
    {
     "@id": "https://wardrobediary.io/data#voice-log.mode",
     "@type": "schema:PropertyValue",
     "schema:name": "mode",
     "schema:description": "match (best matches) or browse (only a garment type was said: that type's garments by photo, most worn lately first).",
     "schema:valueReference": "text",
     "required": false
    },
    {
     "@id": "https://wardrobediary.io/data#voice-log.matcher",
     "@type": "schema:PropertyValue",
     "schema:name": "matcher",
     "schema:description": "Which matcher made the proposals, e.g. voiceMatch v1.",
     "schema:valueReference": "text",
     "required": true
    }
   ]
  },
  {
   "@id": "https://wardrobediary.io/data#public-data",
   "@type": "dcat:Dataset",
   "dct:title": "Public wardrobe data",
   "dct:description": "The world-readable copy for public pages and the MCP server: all garments, the full day-by-day log (as indexes into the garment list) and the comparison items, in one document, so any metric can be computed for any range with one read (decision D-1).",
   "dct:accessRights": {
    "@id": "http://publications.europa.eu/resource/authority/access-right/PUBLIC"
   },
   "classification": "public",
   "location": "Firestore users/{uid}/public/data",
   "dcat:distribution": [
    {
     "@type": "dcat:Distribution",
     "dct:format": "Firestore REST (JSON)",
     "dcat:accessURL": "https://firestore.googleapis.com/v1/projects/threddit-297417/databases/(default)/documents/users/0q0I90W7W3RAcgFN1c1JX6pZupG3/public/data"
    },
    {
     "@type": "dcat:Distribution",
     "dct:format": "web app",
     "dcat:accessURL": "https://wardrobediary.io/dashboard"
    },
    {
     "@type": "dcat:Distribution",
     "dct:format": "MCP server (Streamable HTTP)",
     "dcat:accessURL": "https://wardrobediary.io/mcp"
    }
   ],
   "prov:wasDerivedFrom": [
    {
     "@id": "https://wardrobediary.io/data#garments"
    },
    {
     "@id": "https://wardrobediary.io/data#days"
    },
    {
     "@id": "https://wardrobediary.io/data#comparison"
    }
   ],
   "prov:qualifiedDerivation": [
    {
     "@type": "prov:Derivation",
     "prov:entity": [
      {
       "@id": "https://wardrobediary.io/data#garments"
      },
      {
       "@id": "https://wardrobediary.io/data#days"
      },
      {
       "@id": "https://wardrobediary.io/data#comparison"
      }
     ],
     "prov:hadActivity": "updated in the same write as every change in the app (transactions / batches)",
     "dct:references": {
      "@id": "https://wardrobediary.io/model#decision-D-1"
     }
    }
   ],
   "schema:variableMeasured": [
    {
     "@id": "https://wardrobediary.io/data#public-data.version",
     "@type": "schema:PropertyValue",
     "schema:name": "version",
     "schema:description": "Format version (1).",
     "schema:valueReference": "integer",
     "required": true
    },
    {
     "@id": "https://wardrobediary.io/data#public-data.garments",
     "@type": "schema:PropertyValue",
     "schema:name": "garments",
     "schema:description": "All garments with all their fields (same as dataset garments).",
     "schema:valueReference": "list of garment",
     "required": true
    },
    {
