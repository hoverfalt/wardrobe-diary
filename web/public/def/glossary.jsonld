  },
  {
   "@id": "https://wardrobediary.io/glossary#garment",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Garment",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "One physical piece of clothing, footwear or accessory in the wardrobe, owned at some point since tracking began.",
    "@language": "en"
   },
   "skos:scopeNote": {
    "@value": "Identical items bought together are separate garments, each with its own wears.",
    "@language": "en"
   },
   "skos:related": [
    {
     "@id": "https://wardrobediary.io/glossary#category"
    },
    {
     "@id": "https://wardrobediary.io/glossary#ownership-period"
    }
   ]
  },
  {
   "@id": "https://wardrobediary.io/glossary#category",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Category",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "A kind of clothing that groups garments. The 13 categories, in their standard order: Jackets and hoodies, Blazers and vests, Knits, Shirts, T-shirts and tanks, Pants, Shorts, Belts, Socks, Shoes, Underwear shirts, Underwear boxers, Sportswear.",
    "@language": "en"
   },
   "skos:scopeNote": {
    "@value": "Categories are always listed in this order, never alphabetically.",
    "@language": "en"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#tracking-start",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Start of tracking",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "1 January 2018, the first day of the daily log.",
    "@language": "en"
   },
   "skos:scopeNote": {
    "@value": "Garments bought earlier count as owned from this date; their earlier wears are pre-tracking wears.",
    "@language": "en"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#wear",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Wear",
    "@language": "en"
   },
   "skos:altLabel": [
    {
     "@value": "use",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "One garment worn on one day, as logged. Wearing a garment more than once on the same day is still one wear.",
    "@language": "en"
   },
   "skos:scopeNote": {
    "@value": "Wears logged outside the garment's ownership period are ignored by every metric.",
    "@language": "en"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#pre-tracking-wears",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Pre-tracking wears",
    "@language": "en"
   },
   "skos:altLabel": [
    {
     "@value": "times used init",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "The number of times a garment was worn before tracking began, entered once as an estimate.",
    "@language": "en"
   },
   "skos:scopeNote": {
    "@value": "They count only in figures whose range starts on the start of tracking, and always in lifetime wears.",
    "@language": "en"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#price",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Price",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "What was paid for the garment, in euros, rounded to whole cents.",
    "@language": "en"
   },
   "skos:scopeNote": {
    "@value": "Second-hand garments have the price actually paid. Multipacks are split evenly per item.",
    "@language": "en"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#ownership-period",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Ownership period",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "The days a garment counts as owned: from its purchase date, but no earlier than the start of tracking, to its divest date, both inclusive.",
    "@language": "en"
   },
   "skos:related": [
    {
     "@id": "https://wardrobediary.io/glossary#active"
    },
    {
     "@id": "https://wardrobediary.io/glossary#divested"
    }
   ]
  },
  {
   "@id": "https://wardrobediary.io/glossary#active",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Active",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "A garment is active on a day if that day is within its ownership period.",
    "@language": "en"
   },
   "skos:scopeNote": {
    "@value": "The divest day itself still counts as owned (as in the original R pipeline).",
    "@language": "en"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#divested",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Divested",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "No longer owned after the divest date, because it was sold, given away, recycled or discarded.",
    "@language": "en"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#date-range",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Date range",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "The period a figure is computed for, from a start date to an end date, both inclusive. Every metric takes a date range; the default is from the start of tracking to the last logged day.",
    "@language": "en"
   },
   "dct:references": {
    "@id": "https://wardrobediary.io/model#decision-2026-10-08-ranges"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#as-of",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "As of",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "A figure computed as it was known on a past date, counting only wears logged up to then. Used by the animated charts.",
    "@language": "en"
   },
   "skos:scopeNote": {
    "@value": "The one deliberate exception to the lifetime rule of cost per wear (decision D-2).",
    "@language": "en"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#times-worn",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Times worn",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "The number of wears of a garment within the date range, plus its pre-tracking wears when the range starts on the start of tracking.",
    "@language": "en"
   },
   "rdfs:seeAlso": {
    "@id": "https://wardrobediary.io/model#metric-times-worn"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#lifetime-wears",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Lifetime wears",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "All wears of a garment over its whole ownership period, including pre-tracking wears.",
    "@language": "en"
   },
   "rdfs:seeAlso": {
    "@id": "https://wardrobediary.io/model#metric-lifetime-wears"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#cost-per-wear",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Cost per wear",
    "@language": "en"
   },
   "skos:altLabel": [
    {
     "@value": "CPW",
     "@language": "en"
    },
    {
     "@value": "cost per use",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "For a garment: its price divided by its lifetime wears, regardless of the date range chosen. A garment never worn costs its full price. For a category: the sum of the prices of its garments owned in the range divided by the sum of their lifetime wears, so unworn garments count with their full price (divided by 1 if none has ever been worn).",
    "@language": "en"
   },
   "skos:scopeNote": {
    "@value": "Using lifetime wears, even wears after the range ends, keeps the concept consistent: a garment has one cost per wear, which falls as it gets more use, and a category's cost per wear is what its garments cost over all the use they get. The date range decides only which garments count.",
    "@language": "en"
   },
   "rdfs:seeAlso": {
    "@id": "https://wardrobediary.io/model#metric-garment-cost-per-wear"
   },
   "dct:references": {
    "@id": "https://wardrobediary.io/model#decision-D-2"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#use-weighted-average",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Use-weighted average",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "An average in which each garment counts as many times as it was worn in the range.",
    "@language": "en"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#wears-per-month",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Wears per month",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "Times worn divided by the months owned in the range, where a month is 30.5 days.",
    "@language": "en"
   },
   "rdfs:seeAlso": {
    "@id": "https://wardrobediary.io/model#metric-wears-per-month"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#days-used",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Days used",
    "@language": "en"
   },
   "skos:altLabel": [
    {
     "@value": "frequency of use",
     "@language": "en"
    },
    {
     "@value": "category frequency of use",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "For a category: the share of days on which at least one of its garments was worn, counted from the later of the range start and the day the category's first garment was owned, to the range end.",
    "@language": "en"
   },
   "rdfs:seeAlso": {
    "@id": "https://wardrobediary.io/model#metric-days-used"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#yearly-cost",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Yearly cost",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "What a year of using a category costs at the current rate - its cost per wear × 365 × days used.",
    "@language": "en"
   },
   "rdfs:seeAlso": {
    "@id": "https://wardrobediary.io/model#metric-yearly-cost"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#monthly-cost",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Monthly cost",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "Yearly cost divided by 12. Used to compare clothing categories with other monthly spending.",
    "@language": "en"
   },
   "rdfs:seeAlso": {
    "@id": "https://wardrobediary.io/model#metric-monthly-cost"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#inventory-value",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Inventory value",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "The sum of the prices of the garments active on the range's end date.",
    "@language": "en"
   },
   "rdfs:seeAlso": {
    "@id": "https://wardrobediary.io/model#metric-inventory-value"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#active-items",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Active items",
    "@language": "en"
   },
   "skos:altLabel": [
    {
     "@value": "items",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "The number of garments active on the range's end date.",
    "@language": "en"
   },
   "rdfs:seeAlso": {
    "@id": "https://wardrobediary.io/model#metric-active-items"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#turnover",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Inventory turnover",
    "@language": "en"
   },
   "skos:altLabel": [
    {
     "@value": "turnover",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "Yearly cost divided by inventory value - the share of the wardrobe's purchase value \"used up\" per year.",
    "@language": "en"
   },
   "rdfs:seeAlso": {
    "@id": "https://wardrobediary.io/model#metric-turnover"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#second-hand-share",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Second hand share",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "The share of the garments active on the range's end date that were bought second hand (a count, not a value share).",
    "@language": "en"
   },
   "rdfs:seeAlso": {
    "@id": "https://wardrobediary.io/model#metric-second-hand-share"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#daily-cost",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Daily cost",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "For a day, the sum of the cost per wear of the garments worn that day (and owned then).",
    "@language": "en"
   },
   "skos:scopeNote": {
    "@value": "The Dashboard leaves Sportswear out of its daily cost charts.",
    "@language": "en"
   },
   "rdfs:seeAlso": {
    "@id": "https://wardrobediary.io/model#metric-daily-cost"
   },
   "dct:references": {
    "@id": "https://wardrobediary.io/model#decision-Q-1"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#final-daily-cost",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Final (daily cost)",
    "@language": "en"
   },
   "skos:altLabel": [
    {
     "@value": "all divested",
     "@language": "en"
    }
   ],
   "skos:definition": {
    "@value": "A day's cost is final when every garment worn that day has been divested, so it can no longer fall.",
    "@language": "en"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#tag",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Tag",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "A descriptive label from a fixed vocabulary. Tags only describe garments; they never change any calculation.",
    "@language": "en"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#second-hand",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Second hand (tag)",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "Bought second hand, i.e. used before. The price is what was paid and wears count from the purchase, without estimating earlier use.",
    "@language": "en"
   },
   "skos:related": [
    {
     "@id": "https://wardrobediary.io/glossary#tag"
    }
   ]
  },
  {
   "@id": "https://wardrobediary.io/glossary#hanko",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Hanko (tag)",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "Kept at the summer home in Hanko, so worn only during stays there.",
    "@language": "en"
   },
   "skos:related": [
    {
     "@id": "https://wardrobediary.io/glossary#tag"
    }
   ]
  },
  {
   "@id": "https://wardrobediary.io/glossary#bicycle-gear",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Bicycle gear (tag)",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "Cycling gear.",
    "@language": "en"
   },
   "skos:related": [
    {
     "@id": "https://wardrobediary.io/glossary#tag"
    }
   ]
  },
  {
   "@id": "https://wardrobediary.io/glossary#motorcycle-gear",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Motorcycle gear (tag)",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "Motorcycle gear.",
    "@language": "en"
   },
   "skos:related": [
    {
     "@id": "https://wardrobediary.io/glossary#tag"
    }
   ]
  },
  {
   "@id": "https://wardrobediary.io/glossary#season-tags",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Winter / Summer (tags)",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "Worn mainly in winter or in summer; used to narrow the logging list by season.",
    "@language": "en"
   },
   "skos:related": [
    {
     "@id": "https://wardrobediary.io/glossary#tag"
    }
   ]
  },
  {
   "@id": "https://wardrobediary.io/glossary#materials",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Materials",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "The garment's materials label as written, in free text (e.g. \"Shell 100% polyamide, lining 100% polyester\").",
    "@language": "en"
   },
   "skos:scopeNote": {
    "@value": "The text is never changed; it is interpreted on read into a material composition.",
    "@language": "en"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#main-part",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Main part",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "For a garment whose label lists several parts (shell, lining, padding…), the part that counts in material figures: the one whose label begins with shell, main, outer, body, fabric or belt, otherwise the first one listed.",
    "@language": "en"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#fibre",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Fibre",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "A material a garment is made of, under one normalised name (e.g. lycra and spandex are both elastane, nylon is polyamide).",
    "@language": "en"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#fibre-class",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Fibre class",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "Natural (cotton, wool, linen, leather, down, feather), regenerated cellulose (viscose, modal, lyocell), synthetic (polyester, polyamide, elastane, acrylic…) or other.",
    "@language": "en"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#estimated-composition",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Estimated composition",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "A composition whose shares are not given on the label (or don't add up to 100 %), so the fibres are split equally or normalised.",
    "@language": "en"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#fibre-mass",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Fibre mass",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "Weight × composition, summed per fibre. Owned basis: garments active on the range's end date. Worn basis: every wear in the range counts the garment's full weight.",
    "@language": "en"
   },
   "rdfs:seeAlso": {
    "@id": "https://wardrobediary.io/model#metric-fibre-mass"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#outfit-weight",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Average outfit weight",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "The average total weight of the garments worn per logged day (garments with a known weight).",
    "@language": "en"
   },
   "rdfs:seeAlso": {
    "@id": "https://wardrobediary.io/model#metric-average-outfit-weight"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#coverage",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Coverage",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "How much of the data a material figure could use - garments or wears with both a weight and readable materials, out of all.",
    "@language": "en"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#comparison-item",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Comparison item",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "An item of other everyday spending, such as a transport ticket or a streaming service, with a monthly cost and a use frequency.",
    "@language": "en"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#use-frequency",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Use frequency",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "For a comparison item, the share of days on which it is used (entered by the owner).",
    "@language": "en"
   }
  },
  {
   "@id": "https://wardrobediary.io/glossary#cost-per-use",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://wardrobediary.io/glossary"
   },
   "skos:prefLabel": {
    "@value": "Cost per use (comparison)",
    "@language": "en"
   },
   "skos:definition": {
    "@value": "For a comparison item, its monthly cost divided by (30.5 × use frequency).",
    "@language": "en"
   },
   "rdfs:seeAlso": {
    "@id": "https://wardrobediary.io/model#metric-comparison-cost-per-use"
   }
  }
 ]
}
